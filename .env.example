# ==============================================================================
# AI-SOC Framework Production Configuration
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=3000
FASTAPI_PORT=8088

# Security & Authentication
# Generate strong 32-byte hex secrets for production: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-random-32-byte-hex-secret-in-production
AGENT_ENROLLMENT_KEY=replace-with-a-secure-shared-agent-enrollment-key

# Database Connection
# SQLite (default for low-overhead local deployments)
DATABASE_URL=sqlite:///./aisoc.db
# PostgreSQL (recommended for production multi-agent scale)
# DATABASE_URL=postgresql://aisoc_user:strong_password@127.0.0.1:5432/aisoc_production

# AI Investigation Provider
# Options: 'gemini' or 'local_qwen'
AI_PROVIDER=gemini

# Google Gemini API Key (Server-side only)
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Local LLM Integration (Ollama / vLLM endpoint)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b

# CORS Whitelist (JSON array string)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

