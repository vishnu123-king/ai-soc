[Unit]
Description=AI-SOC Lightweight Linux Endpoint Telemetry Agent
Documentation=https://github.com/aisoc/aisoc-agent
After=network-online.target systemd-journald.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/aisoc-agent start -c /etc/aisoc/agent.conf
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=10s

# User & Execution Context
User=root
Group=root

# State Directories
ReadWritePaths=/var/lib/aisoc
ReadOnlyPaths=/var/log /proc /etc/aisoc

# Security & Sandboxing Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_NET_ADMIN

# Standard Logging to Journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aisoc-agent

[Install]
WantedBy=multi-user.target
